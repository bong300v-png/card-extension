{
  "manifest_version": 3,
  "name": "CardFill Pro",
  "version": "1.1.0",
  "description": "BIN-based card generator, payment form autofiller, and temp-mail with OTP capture for testing",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "alarms", "notifications", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "CardFill Pro",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
